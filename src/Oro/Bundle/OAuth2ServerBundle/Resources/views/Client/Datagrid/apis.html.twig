{%- if record.getValue('allApis') -%}
    {{- 'oro.oauth2server.client.apis.all'|trans -}}
{%- else -%}
    {%- set apis -%}
        {%- for apiLabel in oro_oauth2_api_view_labels(record.getValue('frontend'), record.getValue('apis')) -%}
            {%- if not loop.first %}, {% endif %}{{ apiLabel|oro_html_sanitize }}
        {%- endfor -%}
    {%- endset -%}
    {{- apis -}}
{%- endif -%}
